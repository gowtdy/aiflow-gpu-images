# Copy to .env and adjust. Scripts source .env when present.
# Image tags
# BUILDER_BASE_IMAGE=htmlframes-builder-base:0.1
# BUILDER_IMAGE=htmlframes-builder:0.1
# RUNTIME_IMAGE=htmlframes-image:0.1

# Bun package registry (China default)
BUN_REGISTRY=https://registry.npmmirror.com

# Bun binary zip pre-downloaded to build_assets/software/bun-linux-x64.zip (offline)

# Optional: verbose bun install logs (may clip under BuildKit)
# BUN_INSTALL_VERBOSE=1

# Optional: corporate / local HTTP proxy for GitHub or other overseas fetches.
# Leave unset to use public China mirrors only.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,registry.npmmirror.com,mirrors.aliyun.com,cdn.npmmirror.com
